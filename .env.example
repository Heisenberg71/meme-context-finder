# Required: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: models to try, in order (each must support image input)
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# Start a backup model if the first hasn't started answering after this many ms
# HEDGE_AFTER_MS=2500

# Optional: Google Search grounding. auto = use it, fall back to model knowledge if refused.
# GEMINI_SEARCH=auto
# SEARCH_COOLDOWN_MINUTES=10

# Required in production for counters and rate limits (free at https://upstash.com).
# Without these, an in-memory fallback is used that resets on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional rate-limit overrides. Set the global ones to match your Gemini free-tier quota.
# LIMIT_USER_PER_MINUTE=5
# LIMIT_USER_PER_DAY=30
# LIMIT_IP_PER_MINUTE=10
# LIMIT_IP_PER_DAY=60
# LIMIT_GLOBAL_PER_MINUTE=12
# LIMIT_GLOBAL_PER_DAY=250
